# OpenAI-compatible provider keys
OPENCODE_ZEN_API_KEY=sk-...

# Provider administration. Required for GET/POST/DELETE /v1/providers.
# Use a long random value and send it as X-Admin-Token or Bearer token.
PROVIDERS_ADMIN_TOKEN=replace-with-a-long-random-secret

# Benchmark analytics registry in Neon/PostgreSQL.
# Prefer an unpooled direct URL for writes. DATABASE_URL is the pooled fallback.
DATABASE_DIRECT_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require
BENCH_REGISTRY_CATEGORY=live-memory-adapted-v1

# Qdrant (6333/6334 in container -> 6633/6634 on host)
QDRANT_URL=http://localhost:6633
QDRANT_API_KEY=
# After a connection failure, do not retry Qdrant on every request.
QDRANT_RETRY_SECONDS=30

# Text Embeddings Inference sidecars
EMBEDDING_SIDECAR_URL=http://localhost:8899
RERANK_SIDECAR_URL=http://localhost:8898
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_VECTOR_SIZE=384
RERANK_MODEL=Alibaba-NLP/gte-multilingual-reranker-base

# Hybrid RAG ranking and memory limits
RAG_RRF_K=60
RAG_DENSE_WEIGHT=0.6
RAG_LEXICAL_WEIGHT=0.4
# Increase this only after measuring cosine-score distributions for your corpus.
RAG_MIN_DENSE_SCORE=0.0
RAG_MAX_MEMORY_CHARS=6000
RAG_MAX_QUERY_CHARS=2000
RAG_MAX_SCOPE_RECORDS=2000

# Selective memory gate
MEMORY_MIN_CONFIDENCE=0.65
MEMORY_MIN_IMPORTANCE=0.25
MEMORY_MAX_SELECTED=6
# Old creative/pragmatic/effective collections are excluded by default because
# they contain assistant-generated thoughts rather than verified user memory.
RAG_INCLUDE_LEGACY_PERSPECTIVES=false

# Optional synthesis web search
LANGSEARCH_API_KEY=

# Services
PY_ENGINE_URL=http://localhost:8823
TS_GATEWAY_PORT=9191
OPENWEBUI_URL=http://localhost:3200

# Optional TEI images.
# CPU defaults:
# TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
# RERANK_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
# For GPU use docker-compose.gpu.yml and select a TEI architecture tag
# suitable for the installed GPU when the cuda default is not appropriate.
